# App Configuration
PORT=3000
REDIS_URL=redis://localhost:6379
STATE_TTL_SECONDS=604800

# RENAULT API Configuration
RENAULT_API_BASE=https://opeeu.a5m.opeeu.asdh.aws.renault.com/api/
GIGYA_API_BASE=https://accounts.eu1.gigya.com
GIGYA_API_KEY=
RENAULT_MANUFACTURER_DESCRIPTIONS={"RENAULT":"Renault"}
RENAULT_EMAIL=
RENAULT_PASSWORD=
JOB_CONCURRENCY=2
POLL_INTERVAL_MS=30000
JOB_TIMEOUT_MS=86400000

# S3 Configuration
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_LABOURS_PREFIX=RENAULT_GROUP/files_datasource/RENAULT/Labour_Time
S3_PARTS_PREFIX=RENAULT_GROUP/files_datasource/RENAULT/Parts
S3_SPARE_PART_PREFIX=RENAULT_GROUP/files_datasource
S3_PARTS_SEGMENT=Parts
S3_FORCE_PATH_STYLE=true
S3_AUTO_CREATE_BUCKET=false

# Acciona SQL Server
ACCIONA_SQL_HOST=
ACCIONA_SQL_PORT=1433
ACCIONA_SQL_USER=
ACCIONA_SQL_PASSWORD=
ACCIONA_SQL_ENCRYPT=true
ACCIONA_SQL_TRUST_SERVER_CERTIFICATE=false
ACCIONA_SQL_CONNECT_TIMEOUT_MS=30000
ACCIONA_SQL_REQUEST_TIMEOUT_MS=120000
ACCIONA_SQL_TARGET_DB=_MOK_MOK
ACCIONA_ALLOWED_DATABASES=_MOK_MOK
# Add production database names only when explicitly approved.
ACCIONA_CONFIRM_PRODUCTION=false
ACCIONA_SQL_TOYOTA_CONFIG_DB=Extraccion_TOYOTA_Config
ACCIONA_SQL_GLOBAL_DB=Extraccion_RenaultGroup_Global
ACCIONA_SQL_EXTRACTION_DB_PATTERN=Extraccion_{manufacturer}{epc}
ACCIONA_IMAGES_ROOT=//axesd-sr-BL111.int.audatex.com/Imagenes
ACCIONA_SQL_REFERENCE_DB=Extraccion_DACIA0826
