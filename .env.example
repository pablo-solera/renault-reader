# App / queue
HOST=127.0.0.1
PORT=3000
REDIS_URL=redis://127.0.0.1:6379
STATE_TTL_SECONDS=604800

# Renault ASMDOR (credentials go only here; never commit them)
RENAULT_API_BASE=https://opeeu.a5m.opeeu.asdh.aws.renault.com/api/
GIGYA_API_BASE=https://accounts.eu1.gigya.com
GIGYA_API_KEY=
RENAULT_EMAIL=
RENAULT_PASSWORD=
# Manufacturers advertised by /v1/info
RENAULT_MANUFACTURERS=RENAULT,DACIA
RENAULT_API_TIMEOUT_MS=60000
RENAULT_DOWNLOAD_TIMEOUT_MS=1800000
# ASMDOR does not state the token lifetime; a 401 renews it sooner
RENAULT_TOKEN_TTL_SECONDS=1800

# Worker
JOB_CONCURRENCY=2
POLL_INTERVAL_MS=30000
JOB_TIMEOUT_MS=86400000
WORKER_LOCK_DURATION_MS=900000
WORKER_STALLED_INTERVAL_MS=60000

# S3 compatible storage (objects go under {S3_PREFIX}/RENAULT/...)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PREFIX=
S3_REQUEST_TIMEOUT_MS=600000
S3_FORCE_PATH_STYLE=true
S3_AUTO_CREATE_BUCKET=false
